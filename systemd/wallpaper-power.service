[Unit]
Description=Switch wallpaper based on charger state and internet
After=plasma-workspace.target
PartOf=graphical-session.target

[Service]
ExecStartPre=/bin/sleep 10
ExecStart=%h/.local/bin/wallpaper-power.sh
Restart=on-failure
RestartSec=5
Environment=WALLPAPER_INTERVAL_MIN=10
Environment=WALLPAPER_SOURCE=any
Environment="WALLPAPER_WH_QUERIES=anime city night|anime lonely girl|alone girl|anime night sky girl|anime rain city|anime sitting alone"
Environment="WALLPAPER_KONA_QUERIES=night city|solo night|scenic night|rain city|solo sky"
Environment="WALLPAPER_RES_TIERS=3840x2160 2560x1440"

[Install]
WantedBy=default.target
