[Unit]
Description=Switch wallpaper based on charger state and internet
After=plasma-workspace.target
PartOf=graphical-session.target

[Service]
ExecStartPre=/bin/sleep 10
ExecStart=%h/.local/bin/wallpaper-power.sh
Restart=on-failure
RestartSec=5
# Optional settings (uncomment to use):
 Environment=WALLPAPER_SOURCE=konachan
# Environment=WALLPAPER_WH_QUERY=anime city night
 Environment=WALLPAPER_RES_TIERS=3840x2160 2560x1440

[Install]
WantedBy=default.target
